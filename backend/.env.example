# Copy to .env and set values. Loaded automatically when the app or Alembic imports app.config.
#
# Supabase: Project Settings → Database → Connection string (URI).
# URL-encode special characters in the password if needed.

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Local profile: paper bots run inside `npm run dev:backend` (LIVE + SCHEDULED default on).
# Cloud: keep these false unless you intentionally enable live execution.
# LIVE_DEPLOY_ENABLED=true
# SCHEDULED_BOTS_ENABLED=true
# BOT_POLL_INTERVAL_SECONDS=60
# RUN_BOTS_ON_API_STARTUP=false

# USER_ID is the single-tenant bot scope until Auth cutover. Do not remove on Cloud Run yet.
# USER_ID=local-user

# Supabase Auth (API verifies JWTs). Do not put the service_role key here.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# JWT secret from Project Settings → API (legacy HS256). New ECC projects can omit this
# and verification falls back to JWKS at SUPABASE_URL.
# SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard
# SUPABASE_JWT_AUDIENCE=authenticated
# AUTH_REQUIRED defaults to true for APP_PROFILE=local and false for cloud until cutover.
# AUTH_REQUIRED=true
