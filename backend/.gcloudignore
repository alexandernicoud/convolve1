# =============================================================================
# gcloud builds submit — files matching these patterns are NOT uploaded.
# Docker still installs Python deps via requirements.txt inside the image.
# =============================================================================

# This file itself
.gcloudignore

# Version control (not needed for build context)
.git
.gitignore

# --- Virtual environments (reinstalled in Docker via pip; ~2GB+) ---
.venv/
venv/

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Secrets & local-only env (set in Cloud Run / Secret Manager) ---
.env
.env.local

# --- Local databases ---
*.db
app.db

