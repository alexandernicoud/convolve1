# --- Local dev & tool run outputs (not shipped to Cloud Run; ~2.4GB) ---
runs/

# --- Runtime data dirs (populated via BOT_DATA_DIR / API in prod; ~512MB local) ---
bot_data/

# --- Uploaded / extracted datasets (dev; API accepts uploads at runtime; ~131MB) ---
datasets/

# --- Local .keras / model upload dir (dev registry; not source code; ~1.6GB) ---
models/

# --- OS / editor noise ---
.DS_Store
.idea/
.vscode/

# --- Logs & temp ---
*.log
logs/
tmp/
temp/
